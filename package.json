{
  "name": "birss-app",
  "private": true,
  "version": "0.25.0",
  "description": "Calculates non-zero susceptibility tensor components (Electric Dipole, Magnetic Dipole, Electric Quadrupole) and induced transverse SHG source terms for all 32 crystallographic and 122 magnetic point groups.",
  "author": "Thomas Lottermoser",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/manganite/birss-app.git"
  },
  "homepage": "https://manganite.github.io/birss-app/",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "lint:eslint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:reference": "vitest run reference.test",
    "test:audit": "vitest run audit.test",
    "test:pins": "vitest run pins.test",
    "test:interaction": "vitest run interaction.test",
    "bench": "vitest bench --run",
    "nomenclature": "python3 birss-tables/tools/generate_nomenclature.py",
    "check:nomenclature": "npm run nomenclature && git diff --exit-code birss-tables/table-nomenclature.md",
    "table7data": "node birss-tables/tools/generate_table7_data.mjs",
    "sharingdata": "node scripts/generate-sharing.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "4.1.14",
    "@vitejs/plugin-react": "5.0.4",
    "katex": "0.16.44",
    "lucide-react": "0.546.0",
    "motion": "12.23.24",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-katex": "3.1.0",
    "recharts": "3.8.1"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/katex": "0.16.8",
    "@types/node": "22.14.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/react-katex": "3.0.4",
    "autoprefixer": "10.4.21",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "gh-pages": "6.3.0",
    "jsdom": "29.1.1",
    "prettier": "^3.9.5",
    "tailwindcss": "4.1.14",
    "typescript": "5.8.2",
    "typescript-eslint": "^8.63.0",
    "vite": "6.4.3",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0"
  }
}
